[Unit]
Description=lightinator.de Version API
Documentation=https://github.com/pjakobs/lightinator-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=github-deploy
WorkingDirectory=/home/github-deploy/lightinator-server
ExecStart=/home/github-deploy/lightinator-server/.venv/bin/uvicorn version_api:app --host 0.0.0.0 --port 8765
EnvironmentFile=-/etc/lightinator/version-api.env
Restart=on-failure
RestartSec=5

# Hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
